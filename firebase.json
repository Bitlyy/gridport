{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/get-pricing",
        "function": "getPricing"
      },
      {
        "source": "/api/create-payment",
        "function": "createPayment"
      }
    ]
  }
}
